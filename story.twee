:: StoryTitle
The Last Train Home (Revised)


:: StoryData
{
  "ifid": "B7E3C2A4-5F1D-4E8B-9A26-0C4D7F1E8B53",
  "format": "Harlowe",
  "format-version": "3.3.9",
  "start": "Title",
  "zoom": 0.6
}


:: StoryStylesheet [stylesheet]
@import url('https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Special+Elite&display=swap');

/* =====================================================================
   THE LAST TRAIN HOME — revised stylesheet
   Keeps the original sepia / brass / typewriter identity, and adds:
   fog + vignette + flicker layers, sanity states, HUD, toolbar,
   journal, endings gallery, mobile layout and accessibility options.
   ===================================================================== */

:root {
  --bg: #0b0907;
  --card: rgba(18, 13, 10, 0.9);
  --ink: #d8ccb0;
  --ink-dim: #a99c7f;
  --brass: #a89266;
  --brass-soft: rgba(168, 146, 102, 0.35);
  --gold: #d9a441;
  --gold-hi: #f2c76a;
  --pale: #e9d29b;
  --blood: #d96b4e;
  --blood-deep: #8e2f22;
  --text-size: 1.05rem;
  --toolbar-h: 48px;
  --fog-opacity: 0.55;
  --vignette: 0.55;
  --tint: 0;
}
body.large-text { --text-size: 1.25rem; }

/* ---------- Page ---------- */
html, body {
  margin: 0;
  padding: 0;
  min-height: 100vh;
  background-color: var(--bg);
}
body { overflow-x: clip; }

/* Undo / redo / restart sidebar removed: choices are final.
   Restart lives in the toolbar instead. */
tw-sidebar { display: none !important; }

tw-story {
  position: relative;
  z-index: 2;
  background: var(--card) !important;
  border: 1px solid var(--brass-soft);
  border-radius: 10px;
  max-width: 680px;
  margin: calc(var(--toolbar-h) + 28px) auto 48px;
  padding: 0 2em 2em;
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.85);
  color: var(--ink);
  font-family: "Libre Baskerville", Georgia, serif;
  font-size: var(--text-size);
  line-height: 1.75;
  min-height: 0;
  overflow: visible;
  transition: filter 1.2s ease;
}

/* Story text and dialogue: Libre Baskerville (forced, in case Harlowe sets its own font on the passage) */
tw-story,
tw-passage {
  font-family: "Libre Baskerville", Georgia, serif !important;
}
tw-passage { padding-top: 0.4em; }

/* Wider card on the intro so the picture has room */
tw-story[tags~="intro-bg"] { max-width: 1000px; }
tw-story[tags~="title"] { max-width: 760px; }

/* Links in brass instead of default blue */
tw-link, .enchantment-link, tw-link.visited {
  color: var(--gold);
  font-weight: normal;
  text-decoration: none;
  border-bottom: 1px dotted rgba(217, 164, 65, 0.5);
}
tw-link:hover, .enchantment-link:hover, tw-link.visited:hover {
  color: var(--gold-hi);
  text-shadow: 0 0 8px rgba(242, 199, 106, 0.55);
}
tw-link:focus-visible, button:focus-visible, textarea:focus-visible {
  outline: 2px solid var(--gold-hi);
  outline-offset: 3px;
}

/* ---------- Choices as brass buttons ---------- */
.choices {
  display: flex;
  flex-direction: column;
  gap: 0.6em;
  margin: 1.6em 0 0.4em;
}
.choices br { display: none; }
.choices tw-link,
.choices .locked {
  display: block;
  padding: 0.7em 1em 0.7em 2.1em;
  position: relative;
  border: 1px solid rgba(168, 146, 102, 0.55);
  border-radius: 4px;
  background: linear-gradient(180deg, rgba(40, 28, 18, 0.85), rgba(22, 15, 10, 0.85));
  box-shadow: inset 0 1px 0 rgba(242, 199, 106, 0.08), 0 2px 6px rgba(0, 0, 0, 0.5);
  color: var(--pale);
  line-height: 1.45;
  transition: border-color 0.2s, background 0.2s, transform 0.15s;
}
.choices tw-link::before {
  content: "▸";
  position: absolute;
  left: 0.85em;
  color: var(--brass);
}
.choices tw-link:hover,
.choices tw-link:focus-visible {
  border-color: var(--gold);
  background: linear-gradient(180deg, rgba(58, 40, 22, 0.95), rgba(30, 20, 12, 0.95));
  color: var(--gold-hi);
}
.choices tw-link:active { transform: translateY(1px); }
.choices .locked {
  color: var(--ink-dim);
  font-style: italic;
  border-style: dashed;
  border-color: rgba(168, 146, 102, 0.3);
  background: rgba(0, 0, 0, 0.25);
  box-shadow: none;
  cursor: not-allowed;
}
.choices .locked::before {
  content: "✕";
  position: absolute;
  left: 0.85em;
  font-style: normal;
  color: var(--blood-deep);
}
.choices p { margin: 0 0 0.6em; }

/* ---------- Examinable objects ---------- */
.examine tw-link {
  font-family: "Special Elite", "Courier New", monospace;
  font-size: 0.92em;
  letter-spacing: 0.04em;
  border-bottom: 1px dashed rgba(217, 164, 65, 0.7);
  padding: 0.1em 0.2em;
}
.examine tw-link::before {
  content: "⌕ ";
  color: var(--brass);
}
.examined {
  display: block;
  margin: 0.4em 0 0.2em;
  padding: 0.8em 1em;
  border-left: 2px solid var(--brass);
  background: rgba(233, 210, 155, 0.05);
  color: var(--pale);
  animation: ink-in 0.9s ease both;
}
@keyframes ink-in { from { opacity: 0; filter: blur(3px); } to { opacity: 1; filter: none; } }

/* ---------- Header / HUD (the passage tagged "header") ---------- */
.ltth-data { display: none !important; }

tw-include[type="header"] {
  display: block;
  position: sticky;
  top: var(--toolbar-h);
  z-index: 10;
  margin: 0 -2em 1.2em;
  background: linear-gradient(#1c130c, #120d09);
  border-bottom: 1px solid var(--brass);
  border-radius: 10px 10px 0 0;
}
tw-story[tags~="title"] tw-include[type="header"],
tw-story[tags~="intro-bg"] tw-include[type="header"] { display: none; }

.hud {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.45em 1.2em;
  padding: 0.6em 2em;
  font-family: "Special Elite", "Courier New", monospace;
  font-size: 0.78rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #d8c598;
}
.hud:empty { display: none; }
.hud b { color: var(--brass); font-weight: normal; }
.hud-group { display: inline-flex; align-items: center; gap: 0.5em; white-space: nowrap; }
.status-name {
  display: inline-block;
  max-width: 11em;
  overflow: hidden;
  text-overflow: ellipsis;
  vertical-align: bottom;
}
.hud-cars { display: inline-flex; gap: 4px; margin: 0; padding: 0; list-style: none; }
.hud-cars li {
  min-width: 1.9em;
  padding: 0.05em 0.25em;
  text-align: center;
  border: 1px solid rgba(168, 146, 102, 0.35);
  border-radius: 3px;
  color: rgba(216, 197, 152, 0.4);
  font-size: 0.72rem;
  letter-spacing: 0.04em;
}
.hud-cars li.done { color: var(--brass); border-color: rgba(168, 146, 102, 0.6); }
.hud-cars li.current {
  color: #1a120b;
  background: var(--gold);
  border-color: var(--gold);
  box-shadow: 0 0 8px rgba(217, 164, 65, 0.5);
}
.meter {
  display: inline-block;
  width: 84px;
  height: 7px;
  border: 1px solid rgba(168, 146, 102, 0.6);
  border-radius: 4px;
  background: rgba(0, 0, 0, 0.5);
  overflow: hidden;
  vertical-align: middle;
}
.meter > span {
  display: block;
  height: 100%;
  background: linear-gradient(90deg, #8a6d33, var(--gold));
  transition: width 0.8s ease;
}
body[data-sanity="frayed"] .meter > span { background: linear-gradient(90deg, #7a3a22, #c97a3e); }
body[data-sanity="breaking"] .meter > span { background: linear-gradient(90deg, #5a1a12, var(--blood)); }
.hud-num { min-width: 3.2em; text-align: right; }
.hud-mara { color: var(--pale); }

/* ---------- Intro scene: the picture, with text placed on it ---------- */
.scene {
  position: relative;
  aspect-ratio: 1536 / 1024;
  container-type: inline-size;
  overflow: hidden;
  border: 1px solid rgba(168, 146, 102, 0.4);
  border-radius: 6px;
  background: url("assets/ticket-scene.jpg") center / cover no-repeat;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.7);
}
.scene-title {
  position: absolute;
  left: 4%;
  top: 4%;
  width: 52%;
  text-align: left;
  font-family: "Libre Baskerville", Georgia, serif;
  font-size: 4cqw;
  line-height: 1.1;
  letter-spacing: 0.02em;
  color: var(--pale);
  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.95), 0 0 2px rgba(0, 0, 0, 0.9);
}
.scene-sub {
  display: block;
  margin-top: 0.7em;
  font-family: "Special Elite", "Courier New", monospace;
  font-size: 1.5cqw;
  letter-spacing: 0.28em;
  color: #b9a57a;
  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.95);
}

/* The name, "written" on the ticket's PASSENGER line (mirrors the field below) */
.ticket-name {
  position: absolute;
  left: 38.4%;
  top: 69.2%;
  width: 9%;
  transform: rotate(-8deg);
  transform-origin: left center;
  mix-blend-mode: multiply;
  pointer-events: none;
}
.ticket-ink {
  display: block;
  height: 3.2cqw;
  color: #1f150d;
  font-family: "Special Elite", "Courier New", monospace;
  font-size: 1.2cqw;
  line-height: 3.2cqw;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
  overflow: hidden;
}

/* Large, touch-friendly name field */
.name-field {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5em 1em;
  margin: 1em 0 0.2em;
  padding: 0.8em 1em;
  border: 1px solid rgba(168, 146, 102, 0.4);
  border-radius: 6px;
  background: rgba(0, 0, 0, 0.3);
}
.name-label {
  font-family: "Special Elite", "Courier New", monospace;
  font-size: 0.85rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--brass);
}
.name-field tw-expression, .name-field tw-hook { flex: 1 1 12em; }
.name-field textarea, .name-field input {
  display: block;
  width: 100% !important;
  box-sizing: border-box;
  min-height: 44px;
  margin: 0;
  padding: 0.5em 0.7em;
  border: 1px solid var(--brass) !important;
  border-radius: 4px;
  background: #e9dcbc !important;
  color: #1f150d !important;
  font-family: "Special Elite", "Courier New", monospace !important;
  font-size: 1.05rem !important;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  resize: none !important;
  overflow: hidden;
}

/* ---------- Special Elite helper classes ---------- */
.ticket-text, .announce, .warning, .sign, .speaker {
  font-family: "Special Elite", "Courier New", monospace !important;
  letter-spacing: 0.08em;
}
.announce {
  margin: 1.2em 0;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: #d8c598;
}
.warning {
  margin: 1.2em 0;
  padding: 0.5em 1em;
  text-transform: uppercase;
  color: var(--blood);
  border-left: 3px solid var(--blood-deep);
  background: rgba(142, 47, 34, 0.12);
}
.sign {
  display: inline-block;
  padding: 0.3em 0.9em;
  color: var(--pale);
  border: 1px solid var(--brass);
  background: rgba(0, 0, 0, 0.35);
}
.ticket-text {
  padding: 0.05em 0.4em;
  color: #1f150d;
  background: #d9c9a2;
  border-radius: 2px;
}
.scene-hint {
  margin: 0.6em 0 0;
  font-family: "Special Elite", "Courier New", monospace;
  font-size: 0.8rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--brass);
  text-align: center;
}

/* PA-system announcements: typed out by the script */
.speaker {
  position: relative;
  margin: 0.4em 0 0.2em;
  padding: 0.7em 1em 0.7em 2.6em;
  border: 1px solid rgba(168, 146, 102, 0.3);
  border-radius: 4px;
  background: rgba(0, 0, 0, 0.35);
  color: #e4d3a6;
  font-size: 0.95em;
}
.speaker::before {
  content: "◉";
  position: absolute;
  left: 0.9em;
  top: 0.7em;
  color: var(--blood);
  opacity: 0.8;
  animation: rec 1.6s steps(2) infinite;
}
@keyframes rec { 50% { opacity: 0.2; } }
.speaker.typing::after { content: "▌"; animation: rec 0.8s steps(2) infinite; color: var(--brass); }

/* The voice in the fog */
.voice-call {
  margin: 0.6em 0;
  text-align: center;
  font-style: italic;
  font-size: 1.15em;
  color: #cfd6d8;
  letter-spacing: 0.06em;
  text-shadow: 0 0 12px rgba(200, 215, 220, 0.5);
  animation: voice 4s ease-in-out infinite;
}
@keyframes voice { 50% { opacity: 0.55; letter-spacing: 0.1em; } }
.voice-timer {
  height: 3px;
  margin: 1.2em 0 0.6em;
  background: rgba(168, 146, 102, 0.2);
  border-radius: 2px;
  overflow: hidden;
}
.voice-timer > span {
  display: block;
  height: 100%;
  width: 100%;
  background: var(--blood);
  transform-origin: left center;
  animation: timer 20s linear forwards;
}
@keyframes timer { from { transform: scaleX(1); } to { transform: scaleX(0); } }

/* ---------- Title screen ---------- */
.title-screen { padding: 2.5em 0 0.5em; text-align: center; }
.title-kicker {
  margin: 0;
  font-family: "Special Elite", "Courier New", monospace;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  font-size: 0.8rem;
  color: var(--brass);
}
.title-main {
  margin: 0.25em 0 0.1em;
  font-weight: 400;
  font-size: clamp(2.1rem, 7vw, 3.4rem);
  line-height: 1.1;
  color: var(--pale);
  text-shadow: 0 0 22px rgba(217, 164, 65, 0.25), 0 2px 10px #000;
}
.title-tag { margin: 0 0 1.6em; font-style: italic; color: var(--ink-dim); }
.title-choices { max-width: 22em; margin: 0 auto 1.6em; text-align: left; }
.continue-wrap { display: none; }
.continue-wrap.has-save { display: block; }
.content-note, .howto {
  max-width: 34em;
  margin: 0 auto 1em;
  text-align: left;
  font-size: 0.88em;
  line-height: 1.65;
}
.content-note {
  padding: 0.7em 1em;
  border-left: 3px solid var(--blood-deep);
  background: rgba(142, 47, 34, 0.1);
}
.howto p { margin: 0 0 0.7em; }
.howto b, .content-note b { color: var(--pale); font-weight: 700; }

/* ---------- Endings ---------- */
.ending-card {
  margin: 2.2em 0 1.4em;
  padding: 1.2em 1em;
  text-align: center;
  border-top: 1px solid var(--brass);
  border-bottom: 1px solid var(--brass);
}
.ending-num {
  display: block;
  font-family: "Special Elite", "Courier New", monospace;
  font-size: 0.8rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--brass);
}
.ending-title { display: block; margin-top: 0.3em; font-size: 1.7em; color: var(--pale); }

.gallery {
  max-width: 34em;
  margin: 1.4em auto 0.6em;
  text-align: left;
}
.gallery h2 {
  margin: 0 0 0.6em;
  font-family: "Special Elite", "Courier New", monospace;
  font-weight: normal;
  font-size: 0.9rem;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: var(--brass);
  text-align: center;
}
.gallery ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45em; }
.gallery li {
  display: grid;
  grid-template-columns: 2.4em 1fr;
  gap: 0.2em 0.6em;
  padding: 0.55em 0.8em;
  border: 1px solid rgba(168, 146, 102, 0.3);
  border-radius: 4px;
  background: rgba(0, 0, 0, 0.25);
  font-size: 0.86em;
  line-height: 1.45;
}
.gallery li .g-num { grid-row: span 2; font-family: "Special Elite", monospace; color: var(--brass); }
.gallery li .g-title { color: var(--pale); }
.gallery li .g-hint { color: var(--ink-dim); font-style: italic; }
.gallery li.locked .g-title { color: rgba(216, 204, 176, 0.35); letter-spacing: 0.3em; }
.gallery li.new { border-color: var(--gold); box-shadow: 0 0 10px rgba(217, 164, 65, 0.3); }

/* ---------- Atmosphere layers (added by the story script) ---------- */
.ltth-layer { position: fixed; inset: 0; pointer-events: none; }
.ltth-fog { z-index: 1; overflow: hidden; opacity: var(--fog-opacity); transition: opacity 3s ease; }
.ltth-fog i {
  position: absolute;
  top: -20%;
  left: -50%;
  width: 200%;
  height: 140%;
  background:
    radial-gradient(ellipse 30% 22% at 20% 30%, rgba(190, 170, 120, 0.16), transparent 70%),
    radial-gradient(ellipse 26% 18% at 60% 65%, rgba(170, 150, 110, 0.13), transparent 70%),
    radial-gradient(ellipse 35% 25% at 85% 25%, rgba(200, 185, 140, 0.10), transparent 70%),
    radial-gradient(ellipse 28% 20% at 40% 85%, rgba(160, 140, 100, 0.12), transparent 70%);
  filter: blur(18px);
  animation: drift 70s linear infinite alternate;
}
.ltth-fog i:nth-child(2) { animation-duration: 110s; animation-direction: alternate-reverse; top: 0; opacity: 0.8; }
.ltth-fog i:nth-child(3) { animation-duration: 160s; top: 10%; opacity: 0.6; transform: scaleY(-1); }
@keyframes drift { from { transform: translateX(-12%); } to { transform: translateX(12%); } }

.ltth-vignette {
  z-index: 3;
  background:
    radial-gradient(ellipse at center, transparent 45%, rgba(0, 0, 0, var(--vignette)) 100%),
    rgba(120, 20, 10, var(--tint));
  transition: background 2s ease;
}
.ltth-flicker { z-index: 4; background: #000; opacity: 0; }
.ltth-flicker.on { animation: flicker 1.3s steps(1) 1; }
@keyframes flicker {
  0% { opacity: 0.85; } 8% { opacity: 0; } 16% { opacity: 0.7; } 22% { opacity: 0; }
  60% { opacity: 0; } 64% { opacity: 0.5; } 70% { opacity: 0; } 100% { opacity: 0; }
}

/* ---------- Sanity states (set by the script from $sanity) ---------- */
body[data-sanity="uneasy"]   { --fog-opacity: 0.7;  --vignette: 0.68; }
body[data-sanity="frayed"]   { --fog-opacity: 0.85; --vignette: 0.8;  --tint: 0.04; }
body[data-sanity="breaking"] { --fog-opacity: 1;    --vignette: 0.9;  --tint: 0.09; }
body[data-sanity="frayed"] tw-passage {
  text-shadow: 0.6px 0 rgba(217, 107, 78, 0.22), -0.6px 0 rgba(120, 160, 200, 0.12);
}
body[data-sanity="breaking"] tw-passage {
  text-shadow: 1px 0 rgba(217, 107, 78, 0.35), -1px 0 rgba(120, 160, 200, 0.2);
  animation: unease 9s infinite;
}
body[data-sanity="breaking"] .status-name { animation: glitch 3.5s infinite; }
@keyframes unease {
  0%, 91%, 100% { transform: none; filter: none; }
  92% { transform: translate(1px, -1px) skewX(0.6deg); filter: blur(0.4px); }
  94% { transform: translate(-2px, 1px); }
  96% { transform: none; filter: blur(0.6px); }
}
@keyframes glitch {
  0%, 88%, 100% { opacity: 1; transform: none; }
  90% { opacity: 0.4; transform: translateX(2px); }
  93% { opacity: 1; transform: translateX(-2px); }
}

/* ---------- Toolbar ---------- */
.ltth-toolbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 20;
  height: var(--toolbar-h);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 0 10px;
  background: linear-gradient(rgba(14, 10, 7, 0.97), rgba(14, 10, 7, 0.88));
  border-bottom: 1px solid rgba(168, 146, 102, 0.35);
  backdrop-filter: blur(4px);
}
.ltth-toolbar button {
  display: inline-flex;
  align-items: center;
  gap: 0.4em;
  min-height: 34px;
  padding: 0 0.8em;
  border: 1px solid rgba(168, 146, 102, 0.5);
  border-radius: 4px;
  background: rgba(30, 21, 13, 0.9);
  color: #d8c598;
  font-family: "Special Elite", "Courier New", monospace;
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
}
.ltth-toolbar button:hover { border-color: var(--gold); color: var(--gold-hi); }
.ltth-toolbar button[aria-pressed="true"] {
  background: rgba(217, 164, 65, 0.18);
  border-color: var(--gold);
  color: var(--gold-hi);
}
.ltth-toolbar .ico { font-size: 1rem; line-height: 1; }
.ltth-toolbar .badge {
  min-width: 1.4em;
  padding: 0 0.3em;
  border-radius: 8px;
  background: var(--gold);
  color: #1a120b;
  font-size: 0.7rem;
  text-align: center;
}
.ltth-toolbar .badge:empty { display: none; }
.ltth-toolbar .pulse { animation: pulse-b 1.2s ease 2; }
@keyframes pulse-b { 50% { box-shadow: 0 0 14px rgba(242, 199, 106, 0.8); } }

/* ---------- Toast ---------- */
.ltth-toast {
  position: fixed;
  left: 50%;
  bottom: 22px;
  z-index: 30;
  transform: translate(-50%, 20px);
  max-width: calc(100vw - 32px);
  padding: 0.6em 1.1em;
  border: 1px solid var(--brass);
  border-radius: 4px;
  background: rgba(20, 14, 9, 0.96);
  color: var(--pale);
  font-family: "Special Elite", "Courier New", monospace;
  font-size: 0.85rem;
  letter-spacing: 0.06em;
  opacity: 0;
  transition: opacity 0.4s, transform 0.4s;
  pointer-events: none;
}
.ltth-toast.show { opacity: 1; transform: translate(-50%, 0); }

/* ---------- Dialogs (journal, confirm) ---------- */
.ltth-dialog {
  width: min(560px, calc(100vw - 32px));
  max-height: calc(100vh - 80px);
  padding: 0;
  border: 1px solid var(--brass);
  border-radius: 8px;
  background: #15100b;
  color: var(--ink);
  font-family: "Libre Baskerville", Georgia, serif;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.9);
}
.ltth-dialog::backdrop { background: rgba(0, 0, 0, 0.7); }
.ltth-dialog header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.8em 1.2em;
  border-bottom: 1px solid rgba(168, 146, 102, 0.4);
  background: linear-gradient(#1f150d, #160f0a);
}
.ltth-dialog h2 {
  margin: 0;
  font-family: "Special Elite", "Courier New", monospace;
  font-weight: normal;
  font-size: 1rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--pale);
}
.ltth-dialog .body { padding: 1em 1.2em 1.4em; overflow-y: auto; max-height: calc(100vh - 160px); }
.ltth-dialog h3 {
  margin: 1.1em 0 0.5em;
  font-family: "Special Elite", "Courier New", monospace;
  font-weight: normal;
  font-size: 0.8rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--brass);
}
.ltth-dialog h3:first-child { margin-top: 0; }
.ltth-dialog ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6em; }
.ltth-dialog li {
  padding: 0.6em 0.8em;
  border-left: 2px solid var(--brass);
  background: rgba(233, 210, 155, 0.04);
  font-size: 0.9rem;
  line-height: 1.55;
}
.ltth-dialog li b { display: block; color: var(--pale); font-weight: 700; margin-bottom: 0.15em; }
.ltth-dialog li.torn { border-left-style: dashed; color: var(--ink-dim); font-style: italic; }
.ltth-dialog .empty { color: var(--ink-dim); font-style: italic; font-size: 0.9rem; }
.ltth-dialog .close, .ltth-dialog .actions button {
  min-height: 36px;
  padding: 0 0.9em;
  border: 1px solid rgba(168, 146, 102, 0.6);
  border-radius: 4px;
  background: rgba(30, 21, 13, 0.9);
  color: #d8c598;
  font-family: "Special Elite", "Courier New", monospace;
  letter-spacing: 0.08em;
  cursor: pointer;
}
.ltth-dialog .actions { display: flex; justify-content: flex-end; gap: 0.6em; margin-top: 1.2em; }
.ltth-dialog .actions .danger { border-color: var(--blood); color: var(--blood); }

/* ---------- Mobile ---------- */
@media (max-width: 640px) {
  :root { --toolbar-h: 52px; }
  tw-story {
    margin: var(--toolbar-h) 0 0;
    padding: 0 16px 1.5em;
    border-radius: 0;
    border-left: 0;
    border-right: 0;
    font-size: calc(var(--text-size) - 0.05rem);
    line-height: 1.7;
  }
  tw-include[type="header"] { margin: 0 -16px 1em; border-radius: 0; }
  .hud { padding: 0.5em 16px; font-size: 0.7rem; gap: 0.35em 0.8em; }
  .meter { width: 60px; }
  .ltth-toolbar { gap: 4px; padding: 0 6px; }
  .ltth-toolbar button { padding: 0 0.55em; font-size: 0.7rem; }
  .ltth-toolbar .lbl { display: none; }
  .ltth-toolbar .ico { font-size: 1.15rem; }
  .ltth-toolbar button { min-width: 44px; min-height: 40px; justify-content: center; }
  .ticket-ink { font-size: 1.6cqw; }
  .title-screen { padding-top: 1.6em; }
}

/* ---------- Reduced motion ---------- */
body.reduce-motion .ltth-fog i,
body.reduce-motion tw-passage,
body.reduce-motion .status-name,
body.reduce-motion .voice-call,
body.reduce-motion .speaker::before,
body.reduce-motion .examined,
body.reduce-motion .ltth-toolbar .pulse {
  animation: none !important;
}
body.reduce-motion .ltth-flicker.on { animation: none; }
body.reduce-motion tw-transition-container { animation: none !important; }


:: StoryScript [script]
/* =====================================================================
   THE LAST TRAIN HOME — revised story script
   Harlowe keeps the story state. Each passage's header writes the state
   into a hidden <div class="ltth-data">; this script reads it after every
   render and drives the interface around the story:
     - fog, vignette and flicker layers, and sanity-based visual states
     - the HUD (passenger, sanity meter, carriage progress, companions)
     - toolbar: Journal, Sound, Motion, Text size, Restart
     - journal dialog (clues, items, companions)
     - endings gallery (stored in this browser's localStorage)
     - typewriter effect for PA announcements
     - optional procedural ambient sound (Web Audio, off by default)
   ===================================================================== */
(function () {
  'use strict';
  if (window.LTTH) return;

  /* ---------------- storage helpers (never throw) ---------------- */
  function lsGet(key, fallback) {
    try { var v = localStorage.getItem(key); return v ? JSON.parse(v) : fallback; }
    catch (e) { return fallback; }
  }
  function lsSet(key, value) {
    try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) { /* ignore */ }
  }
  var IFID = (document.querySelector('tw-storydata') || { getAttribute: function () { return ''; } }).getAttribute('ifid');
  var SAVE_KEYS = ['(Saved Game ' + IFID + ') auto', '(Saved Game Filename ' + IFID + ') auto'];
  function hasSave() {
    try { return localStorage.getItem(SAVE_KEYS[0]) !== null; } catch (e) { return false; }
  }
  function clearSave() {
    try { SAVE_KEYS.forEach(function (k) { localStorage.removeItem(k); }); } catch (e) { /* ignore */ }
  }
  function clearSession() {
    try { sessionStorage.removeItem('Saved Session'); } catch (e) { /* ignore */ }
  }

  /* ---------------- content ---------------- */
  var CLUES = {
    'warning': ['The conductor’s warning', '“If you hear someone calling your name from outside the train, do not answer.”'],
    'newspaper': ['A newspaper, October 28, 1891', 'MIDNIGHT EXPRESS LOST IN FOG. Line Zero left Ashgrove at midnight and never arrived. Among the missing: the conductor, eleven passengers, and a boy of nine travelling alone.'],
    'armrest': ['Scratches on an armrest', 'DON’T FALL ASLEEP. The letters are fresh, and lean the way yours do.'],
    'conductor-notebook': ['The conductor’s notebook', 'A passenger list. Nearly every name is crossed out. “Seat 13 — M.” is not. Your name is the last entry, and the ink is still wet.'],
    'station-sign': ['The platform at Ashgrove', 'The station sign has CLOSED painted across it. A figure under the last lamp, waiting for a train that has already left.'],
    'mara-photo': ['Mara’s photograph', 'A little girl in a yellow coat. For a moment, words on the window behind her: SHE NEVER BOARDED.'],
    'place-cards': ['Place cards in the dining car', 'Every seat is reserved, each card with a name and a date. Yours bears tonight’s. The conductor’s has no date at all.'],
    'girl-on-platform': ['Thomas’s girl in yellow', '“There’s a girl in a yellow coat who waves at the train every night. She was little when I first saw her. She’s grown up now.”'],
    'unsent-letter': ['An unsent letter', 'In your own hand, the ink run as if by rain: “I’m on the last train. Leave the porch light on.”'],
    'firebox': ['The firebox', 'The engine burns tickets. Each one punched once. None of them ever coming back.']
  };
  var ITEMS = {
    lantern: ['Railway lantern', 'Hooded brass, half full of paraffin. It keeps the dark at arm’s length.'],
    keycard: ['Brass keycard', 'Stamped LOCOMOTIVE — CREW ONLY. Found folded in the conductor’s napkin.'],
    watch: ['Thomas’s pocket watch', 'The second hand runs backward. It ticks against your palm, sharp as a pin, and will not let you rest.']
  };
  var ENDINGS = [
    { id: 'home', num: 'I', title: 'Home', hint: 'Understand enough to let go.' },
    { id: 'together', num: 'II', title: 'Together', hint: 'Some people should not be left behind, or lied to.' },
    { id: 'conductor', num: 'III', title: 'The New Conductor', hint: 'Somebody has to punch the tickets.' },
    { id: 'sleep', num: 'IV', title: 'The Long Sleep', hint: 'The armrest gave you good advice.' },
    { id: 'nowhere', num: 'V', title: 'Nowhere Station', hint: 'Some voices should not be answered.' }
  ];
  var ROMAN = ['I', 'II', 'III', 'IV', 'V'];

  /* ---------------- settings ---------------- */
  var prefersReduce = false;
  try { prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) { /* ignore */ }
  var settings = Object.assign({ reduceMotion: prefersReduce, largeText: false }, lsGet('ltth-settings', {}));
  function saveSettings() { lsSet('ltth-settings', settings); }
  function applySettings() {
    document.body.classList.toggle('reduce-motion', !!settings.reduceMotion);
    document.body.classList.toggle('large-text', !!settings.largeText);
  }

  /* ---------------- DOM helpers ---------------- */
  function el(tag, attrs, html) {
    var n = document.createElement(tag);
    if (attrs) Object.keys(attrs).forEach(function (k) { n.setAttribute(k, attrs[k]); });
    if (html != null) n.innerHTML = html;
    return n;
  }
  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  /* ---------------- atmosphere layers ---------------- */
  var fog = el('div', { 'class': 'ltth-layer ltth-fog', 'aria-hidden': 'true' }, '<i></i><i></i><i></i>');
  var vignette = el('div', { 'class': 'ltth-layer ltth-vignette', 'aria-hidden': 'true' });
  var flicker = el('div', { 'class': 'ltth-layer ltth-flicker', 'aria-hidden': 'true' });
  document.body.appendChild(fog);
  document.body.appendChild(vignette);
  document.body.appendChild(flicker);

  function doFlicker() {
    if (settings.reduceMotion) return;
    flicker.classList.remove('on');
    void flicker.offsetWidth; // restart animation
    flicker.classList.add('on');
    Sound.staticBurst(0.8);
  }

  /* ---------------- toast ---------------- */
  var toast = el('div', { 'class': 'ltth-toast', role: 'status', 'aria-live': 'polite' });
  document.body.appendChild(toast);
  var toastTimer;
  function showToast(msg) {
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toast.classList.remove('show'); }, 2600);
  }

  /* ---------------- toolbar ---------------- */
  var toolbar = el('nav', { 'class': 'ltth-toolbar', 'aria-label': 'Game controls' });
  toolbar.innerHTML =
    '<button type="button" data-act="journal" aria-label="Open journal"><span class="ico" aria-hidden="true">✎</span><span class="lbl">Journal</span><span class="badge"></span></button>' +
    '<button type="button" data-act="sound" aria-pressed="false" aria-label="Ambient sound"><span class="ico" aria-hidden="true">♪</span><span class="lbl">Sound: Off</span></button>' +
    '<button type="button" data-act="motion" aria-pressed="false" aria-label="Reduce motion"><span class="ico" aria-hidden="true">◐</span><span class="lbl">Reduce motion</span></button>' +
    '<button type="button" data-act="text" aria-pressed="false" aria-label="Larger text"><span class="ico" aria-hidden="true">A+</span><span class="lbl">Text</span></button>' +
    '<button type="button" data-act="restart" aria-label="Restart the game"><span class="ico" aria-hidden="true">↺</span><span class="lbl">Restart</span></button>';
  document.body.appendChild(toolbar);
  var btn = {};
  toolbar.querySelectorAll('button').forEach(function (b) { btn[b.getAttribute('data-act')] = b; });

  function syncToolbar() {
    btn.sound.setAttribute('aria-pressed', String(Sound.on));
    btn.sound.querySelector('.lbl').textContent = Sound.on ? 'Sound: On' : 'Sound: Off';
    btn.motion.setAttribute('aria-pressed', String(!!settings.reduceMotion));
    btn.text.setAttribute('aria-pressed', String(!!settings.largeText));
  }
  toolbar.addEventListener('click', function (e) {
    var b = e.target.closest('button');
    if (!b) return;
    var act = b.getAttribute('data-act');
    if (act === 'journal') openJournal();
    if (act === 'sound') { Sound.toggle(); syncToolbar(); }
    if (act === 'motion') {
      settings.reduceMotion = !settings.reduceMotion; saveSettings(); applySettings(); syncToolbar();
      showToast(settings.reduceMotion ? 'Motion reduced' : 'Motion effects on');
    }
    if (act === 'text') {
      settings.largeText = !settings.largeText; saveSettings(); applySettings(); syncToolbar();
    }
    if (act === 'restart') openConfirm();
  });

  /* ---------------- journal dialog ---------------- */
  var journal = el('dialog', { 'class': 'ltth-dialog', 'aria-labelledby': 'ltth-j-title' });
  journal.innerHTML = '<header><h2 id="ltth-j-title">Journal</h2><button type="button" class="close" aria-label="Close journal">Close</button></header><div class="body"></div>';
  document.body.appendChild(journal);
  journal.querySelector('.close').addEventListener('click', function () { journal.close(); });
  journal.addEventListener('click', function (e) { if (e.target === journal) journal.close(); });

  function renderJournal() {
    var s = current || readState() || { clues: [], forgotten: '' };
    var h = '<h3>What you have noticed</h3>';
    if (s.clues.length) {
      h += '<ul>' + s.clues.map(function (c) {
        var d = CLUES[c]; return d ? '<li><b>' + esc(d[0]) + '</b>' + esc(d[1]) + '</li>' : '';
      }).join('') + '</ul>';
    } else {
      h += '<p class="empty">Nothing yet. Look closely at things marked with a lens.</p>';
    }
    if (s.forgotten) h += '<ul><li class="torn">A page has been torn out. You remember that something was written here. You do not remember what.</li></ul>';
    h += '<h3>What you carry</h3>';
    var items = [];
    items.push('<li><b>Your ticket</b>Midnight Express, Line 0. Passenger: ' + esc(s.name || 'Traveler') + '.</li>');
    if (s.lantern) items.push('<li><b>' + ITEMS.lantern[0] + '</b>' + ITEMS.lantern[1] + '</li>');
    if (s.keycard) items.push('<li><b>' + ITEMS.keycard[0] + '</b>' + ITEMS.keycard[1] + '</li>');
    if (s.watch) items.push('<li><b>' + ITEMS.watch[0] + '</b>' + ITEMS.watch[1] + '</li>');
    h += '<ul>' + items.join('') + '</ul>';
    h += '<h3>Who travels with you</h3>';
    var who = [];
    if (s.maraF) who.push('<li><b>Mara</b>' + maraMood(s.trust) + '</li>');
    if (s.thomas) who.push('<li><b>Thomas</b>Nine years old, travelling alone. Not any more.</li>');
    h += who.length ? '<ul>' + who.join('') + '</ul>' : '<p class="empty">No one.</p>';
    journal.querySelector('.body').innerHTML = h;
  }
  function openJournal() {
    renderJournal();
    btn.journal.querySelector('.badge').textContent = '';
    if (journal.showModal) journal.showModal(); else journal.setAttribute('open', '');
  }
  function maraMood(t) {
    if (t >= 3) return 'She trusts you. She walks close enough to touch.';
    if (t >= 1) return 'She is beginning to trust you.';
    if (t >= 0) return 'She is uncertain of you, but she is here.';
    return 'She keeps her distance. She has not forgotten how you treated her.';
  }

  /* ---------------- restart confirm ---------------- */
  var confirmDlg = el('dialog', { 'class': 'ltth-dialog', 'aria-labelledby': 'ltth-c-title' });
  confirmDlg.innerHTML = '<header><h2 id="ltth-c-title">Restart</h2></header><div class="body"><p>Start a new journey from the beginning? Your current progress and autosave will be lost. Endings you have discovered are kept.</p><div class="actions"><button type="button" data-c="no">Keep playing</button><button type="button" class="danger" data-c="yes">Restart</button></div></div>';
  document.body.appendChild(confirmDlg);
  confirmDlg.addEventListener('click', function (e) {
    var b = e.target.closest('button');
    if (!b) return;
    if (b.getAttribute('data-c') === 'yes') restartGame();
    else confirmDlg.close();
  });
  function openConfirm() { if (confirmDlg.showModal) confirmDlg.showModal(); else if (window.confirm('Restart the game?')) restartGame(); }
  function restartGame() {
    clearSave();
    clearSession();
    window.location.reload();
  }

  /* ---------------- endings gallery ---------------- */
  function foundEndings() { return lsGet('ltth-endings', []); }
  function renderGalleries(newId) {
    var found = foundEndings();
    document.querySelectorAll('.gallery-slot').forEach(function (slot) {
      var h = '<div class="gallery"><h2>Endings discovered: ' + found.length + ' of ' + ENDINGS.length + '</h2><ol>';
      ENDINGS.forEach(function (e) {
        var got = found.indexOf(e.id) !== -1;
        h += '<li class="' + (got ? 'found' : 'locked') + (e.id === newId ? ' new' : '') + '">' +
          '<span class="g-num">' + e.num + '</span>' +
          '<span class="g-title">' + (got ? esc(e.title) : '? ? ?') + '</span>' +
          '<span class="g-hint">' + esc(e.hint) + '</span></li>';
      });
      slot.innerHTML = h + '</ol></div>';
    });
  }
  function recordEnding(id) {
    var found = foundEndings();
    if (found.indexOf(id) === -1) { found.push(id); lsSet('ltth-endings', found); }
    clearSave(); // a finished journey cannot be continued
  }

  /* ---------------- read Harlowe state from the header ---------------- */
  function readState() {
    var d = document.querySelector('.ltth-data');
    if (!d) return null;
    function get(k) { var n = d.querySelector('.k-' + k); return n ? n.textContent.trim() : ''; }
    return {
      name: get('name'),
      passage: get('passage'),
      sanity: parseInt(get('sanity'), 10) || 0,
      car: parseInt(get('car'), 10) || 0,
      passengers: parseInt(get('passengers'), 10) || 0,
      maraF: get('maraF') === 'true',
      trust: parseInt(get('trust'), 10) || 0,
      lantern: get('lantern') === 'true',
      keycard: get('keycard') === 'true',
      watch: get('watch') === 'true',
      thomas: get('thomas') === 'true',
      forgotten: get('forgotten'),
      clues: Array.prototype.map.call(d.querySelectorAll('.k-clues i'), function (i) { return i.textContent.trim(); })
    };
  }
  function band(s) { return s >= 75 ? 'calm' : s >= 50 ? 'uneasy' : s >= 25 ? 'frayed' : 'breaking'; }

  function renderHud(s) {
    var hud = document.querySelector('tw-include[type="header"] .hud');
    if (!hud) return;
    if (!s || s.car < 1) { hud.innerHTML = ''; return; }
    var cars = ROMAN.map(function (r, i) {
      var n = i + 1;
      var cls = n < s.car ? 'done' : n === s.car ? 'current' : '';
      return '<li class="' + cls + '"' + (n === s.car ? ' aria-current="step"' : '') + '>' + r + '</li>';
    }).join('');
    var company = [];
    if (s.maraF) company.push('Mara');
    if (s.thomas) company.push('Thomas');
    hud.innerHTML =
      '<span class="hud-group"><b>Passenger:</b> <span class="status-name">' + esc(s.name) + '</span></span>' +
      '<span class="hud-group" role="img" aria-label="Sanity ' + s.sanity + ' percent"><b>Sanity:</b> <span class="meter"><span style="width:' + Math.max(0, Math.min(100, s.sanity)) + '%"></span></span><span class="hud-num">' + s.sanity + '%</span></span>' +
      '<span class="hud-group"><b>Carriage:</b> <ol class="hud-cars" aria-label="Carriage ' + s.car + ' of 5">' + cars + '</ol></span>' +
      '<span class="hud-group"><b>Passengers:</b> <span class="hud-mara">' + s.passengers + (company.length ? ' — ' + company.join(', ') : '') + '</span></span>';
  }

  /* ---------------- per-passage enhancements ---------------- */
  function passageTags() {
    var p = document.querySelector('tw-passage');
    var t = (p && p.getAttribute('tags')) || (document.querySelector('tw-story') || { getAttribute: function () { return ''; } }).getAttribute('tags') || '';
    return t.split(/\s+/).filter(Boolean);
  }

  function typewrite(node) {
    if (node.getAttribute('data-typed')) return;
    node.setAttribute('data-typed', '1');
    if (settings.reduceMotion) return;
    var walker = document.createTreeWalker(node, NodeFilter.SHOW_TEXT, null);
    var texts = [], t;
    while ((t = walker.nextNode())) { texts.push({ node: t, full: t.nodeValue }); t.nodeValue = ''; }
    node.classList.add('typing');
    var i = 0, j = 0, timer;
    function finish() {
      clearInterval(timer);
      texts.forEach(function (x) { x.node.nodeValue = x.full; });
      node.classList.remove('typing');
    }
    node.addEventListener('click', finish, { once: true });
    timer = setInterval(function () {
      if (!document.body.contains(node)) { clearInterval(timer); return; }
      if (i >= texts.length) { finish(); return; }
      j += 1;
      texts[i].node.nodeValue = texts[i].full.slice(0, j);
      if (j >= texts[i].full.length) { i += 1; j = 0; }
    }, 24);
  }

  function setupNameField() {
    var field = document.querySelector('.name-field textarea, .name-field input');
    var ink = document.querySelector('.ticket-ink');
    if (!field || field.getAttribute('data-ltth')) return;
    field.setAttribute('data-ltth', '1');
    field.setAttribute('maxlength', '16');
    field.setAttribute('aria-label', 'Your name, as written on the ticket');
    field.setAttribute('autocomplete', 'off');
    field.setAttribute('spellcheck', 'false');
    function sync() { if (ink) ink.textContent = field.value.trim() || 'Traveler'; }
    field.addEventListener('input', sync);
    field.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); field.blur(); } });
    sync();
  }

  var lastPassage = null, lastSig = '', prev = null, current = null;
  function onRender() {
    var passage = document.querySelector('tw-passage');
    var s = readState();
    var sig = s ? JSON.stringify(s) : '';
    var isNewPassage = passage && passage !== lastPassage;
    if (!isNewPassage && sig === lastSig) return;
    lastSig = sig;

    if (s) {
      current = s;
      document.body.setAttribute('data-sanity', band(s.sanity));
      Sound.setSanity(s.sanity);
      // journal notifications for things gained mid-game
      if (prev && s.car >= 1) {
        var gained = s.clues.filter(function (c) { return prev.clues.indexOf(c) === -1; }).length +
          (s.lantern && !prev.lantern ? 1 : 0) + (s.keycard && !prev.keycard ? 1 : 0) + (s.watch && !prev.watch ? 1 : 0);
        if (gained > 0) {
          var badge = btn.journal.querySelector('.badge');
          badge.textContent = String((parseInt(badge.textContent, 10) || 0) + gained);
          btn.journal.classList.remove('pulse'); void btn.journal.offsetWidth; btn.journal.classList.add('pulse');
          showToast('Your journal has a new entry');
        }
        if (s.forgotten && !prev.forgotten) showToast('Something has been forgotten');
      }
      prev = s;
    } else {
      document.body.setAttribute('data-sanity', 'calm');
    }
    renderHud(s);

    if (isNewPassage) {
      lastPassage = passage;
      var tags = passageTags();
      if (tags.indexOf('flicker') !== -1) setTimeout(doFlicker, 250);
      document.querySelectorAll('tw-passage .speaker').forEach(typewrite);
      setupNameField();
      document.querySelectorAll('.continue-wrap').forEach(function (w) { w.classList.toggle('has-save', hasSave()); });
      var endTag = tags.filter(function (t) { return t.indexOf('end-') === 0; })[0];
      if (endTag) { recordEnding(endTag.slice(4)); renderGalleries(endTag.slice(4)); }
      else renderGalleries(null);
      if (journal.open) renderJournal();
    }
  }

  var scheduled = false;
  var observer = new MutationObserver(function () {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(function () { scheduled = false; onRender(); });
  });
  function attach() {
    var story = document.querySelector('tw-story');
    if (!story) { requestAnimationFrame(attach); return; }
    observer.observe(story, { childList: true, subtree: true, characterData: true });
    onRender();
  }

  /* =================================================================
     Ambient sound: generated live with the Web Audio API, so the game
     needs no audio files. Off by default; only starts when the player
     presses the Sound button (which also satisfies browser autoplay rules).
       - rumble: low-passed brown noise with a slow swell
       - wheels: paired "clack-clack" of rail joints with a thump
       - hum: two detuned low sawtooth tones (the engine)
       - mechanical: occasional metallic creak / brake squeal
       - static: crackling radio bursts, more frequent as sanity falls
     ================================================================= */
  var Sound = (function () {
    var AC = window.AudioContext || window.webkitAudioContext;
    var ctx = null, master = null, white = null, timers = [], sanity = 100;
    var api = { on: false };

    function noise(kind) {
      var len = ctx.sampleRate * 4, buf = ctx.createBuffer(1, len, ctx.sampleRate), d = buf.getChannelData(0), last = 0;
      for (var i = 0; i < len; i++) {
        var w = Math.random() * 2 - 1;
        if (kind === 'brown') { last = (last + 0.02 * w) / 1.02; d[i] = last * 3.5; } else d[i] = w;
      }
      return buf;
    }
    function build() {
      ctx = new AC();
      master = ctx.createGain(); master.gain.value = 0; master.connect(ctx.destination);
      white = noise('white');
      // rumble
      var rb = ctx.createBufferSource(); rb.buffer = noise('brown'); rb.loop = true;
      var lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 150;
      var rg = ctx.createGain(); rg.gain.value = 0.55;
      var lfo = ctx.createOscillator(); lfo.frequency.value = 0.11;
      var lfoAmt = ctx.createGain(); lfoAmt.gain.value = 0.18;
      lfo.connect(lfoAmt); lfoAmt.connect(rg.gain); lfo.start();
      rb.connect(lp); lp.connect(rg); rg.connect(master); rb.start();
      // engine hum
      [55, 110.6].forEach(function (f) {
        var o = ctx.createOscillator(); o.type = 'sawtooth'; o.frequency.value = f;
        var fl = ctx.createBiquadFilter(); fl.type = 'lowpass'; fl.frequency.value = 170;
        var g = ctx.createGain(); g.gain.value = 0.016;
        o.connect(fl); fl.connect(g); g.connect(master); o.start();
      });
    }
    function burst(t, dur, freq, q, gain) {
      var s = ctx.createBufferSource(); s.buffer = white;
      var bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = freq; bp.Q.value = q;
      var g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(gain, t + 0.006);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      s.connect(bp); bp.connect(g); g.connect(master);
      s.start(t, Math.random() * 3); s.stop(t + dur + 0.05);
    }
    function wheels() {
      if (!api.on) return;
      var t = ctx.currentTime + 0.05;
      burst(t, 0.1, 950, 4, 0.2); burst(t + 0.17, 0.1, 820, 4, 0.16);
      burst(t + 0.02, 0.3, 140, 1, 0.3);
      timers.push(setTimeout(wheels, 1600 + Math.random() * 450));
    }
    function creak() {
      if (!api.on) return;
      var t = ctx.currentTime + 0.05, o = ctx.createOscillator(), bp = ctx.createBiquadFilter(), g = ctx.createGain();
      var f = 700 + Math.random() * 900;
      o.type = 'triangle';
      o.frequency.setValueAtTime(f, t); o.frequency.linearRampToValueAtTime(f * 0.82, t + 1.6);
      bp.type = 'bandpass'; bp.frequency.value = f; bp.Q.value = 9;
      g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(0.035, t + 0.4); g.gain.exponentialRampToValueAtTime(0.0001, t + 1.8);
      o.connect(bp); bp.connect(g); g.connect(master); o.start(t); o.stop(t + 1.9);
      timers.push(setTimeout(creak, 18000 + Math.random() * 22000));
    }
    function crackle(strength) {
      if (!ctx || !api.on) return;
      var t = ctx.currentTime + 0.02, dur = 0.3 + Math.random() * 0.9 * (strength || 1);
      burst(t, dur, 2600, 0.7, 0.07 * (strength || 1));
      for (var k = 0; k < 6; k++) burst(t + Math.random() * dur, 0.03, 4000 + Math.random() * 3000, 2, 0.08 * (strength || 1));
    }
    function staticLoop() {
      if (!api.on) return;
      crackle(sanity < 25 ? 1.4 : sanity < 50 ? 1.1 : 0.8);
      var base = sanity < 25 ? 4500 : sanity < 50 ? 8000 : 14000;
      timers.push(setTimeout(staticLoop, base + Math.random() * base));
    }
    api.toggle = function () {
      if (!AC) { showToast('Sound is not supported in this browser'); return; }
      if (!api.on) {
        if (!ctx) build();
        ctx.resume();
        api.on = true;
        master.gain.cancelScheduledValues(ctx.currentTime);
        master.gain.setTargetAtTime(0.85, ctx.currentTime, 0.8);
        wheels();
        timers.push(setTimeout(staticLoop, 3000));
        timers.push(setTimeout(creak, 9000));
      } else {
        api.on = false;
        timers.forEach(clearTimeout); timers = [];
        master.gain.cancelScheduledValues(ctx.currentTime);
        master.gain.setTargetAtTime(0, ctx.currentTime, 0.25);
        setTimeout(function () { if (!api.on && ctx) ctx.suspend(); }, 1200);
      }
    };
    api.staticBurst = function (s) { crackle(s); };
    api.setSanity = function (s) { sanity = s; };
    return api;
  })();

  /* ---------------- start ---------------- */
  applySettings();
  syncToolbar();
  attach();

  window.LTTH = { readState: readState, sound: Sound, endings: foundEndings, hasSave: hasSave };
})();


:: Title [title] {"position": "200,1700", "size": "100,100"}
{<div class="title-screen">
<p class="title-kicker">Midnight Express — Line 0</p>
<h1 class="title-main">The Last Train Home</h1>
<p class="title-tag">An interactive horror mystery</p>
<div class="choices title-choices">
[[Begin the journey->Introduction]]
<span class="continue-wrap">(link: "Continue your journey")[(load-game: "auto")]</span>
</div>
<div class="content-note"><b>Content note.</b> This story contains psychological horror, grief, and references to death and the loss of a child.</div>
<div class="howto">
<p><b>How to play.</b> Choose what to do from the brass buttons at the end of each scene. Underlined objects marked with a lens can be examined. What you notice is written in your <b>Journal</b>.</p>
<p>Your choices cannot be undone. Your <b>sanity</b>, the trust of the people you meet, and what you discover all decide where this train takes you. There are five endings.</p>
<p>The game saves automatically. Sound is <b>off</b> until you turn it on. Use the toolbar to reduce motion or enlarge the text.</p>
</div>
<div class="gallery-slot"></div>
</div>}


